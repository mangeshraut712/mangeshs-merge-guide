{
  "name": "@mangeshraut712/merge-guide",
  "version": "0.1.0",
  "description": "Install Mangesh’s Merge Guide into a supported agent skill directory",
  "license": "MIT",
  "type": "module",
  "bin": {
    "merge-guide": "bin/merge-guide.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/*.js",
    "skills/oss-contribution-insights/SKILL.md",
    "skills/oss-contribution-insights/LICENSE",
    "skills/oss-contribution-insights/agents/*.yaml",
    "skills/oss-contribution-insights/assets/*.json",
    "skills/oss-contribution-insights/references/*.md",
    "skills/oss-contribution-insights/scripts/*.py",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test test/installer.test.js",
    "test:package": "node test/package-smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mangeshraut712/mangeshs-merge-guide.git"
  },
  "homepage": "https://github.com/mangeshraut712/mangeshs-merge-guide#readme",
  "bugs": {
    "url": "https://github.com/mangeshraut712/mangeshs-merge-guide/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
